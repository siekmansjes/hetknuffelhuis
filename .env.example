# Kopieer naar .env.local en vul in. Zonder deze waarden werkt de site lokaal
# gewoon: formulieren slagen dan zonder iets op te slaan (alleen in development).

# HubSpot Private App token (scopes: crm.objects.contacts.read/write,
# crm.objects.companies.read/write, crm.objects.deals.read/write,
# crm.objects.notes.write, files). Nooit committen.
HUBSPOT_PRIVATE_API_TOKEN=
# Pipeline, fase en eigenaar van nieuwe deals (zie HubSpot > Deals > Pipelines).
HUBSPOT_DEAL_PIPELINE_ID=default
HUBSPOT_DEAL_STAGE_ID=
HUBSPOT_DEAL_OWNER_ID=

# Bevestigingsmails via Resend (optioneel; zonder sleutel geen mails). Het
# afzenderadres komt uit COMPANY.email in src/lib/site.ts en moet bij Resend
# geverifieerd zijn.
RESEND_API_KEY=

# Google Analytics 4 (optioneel; zonder ID geen tracking en geen cookiemelding).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Echt domein, bv. https://hetknuffelhuis.nl
NEXT_PUBLIC_SITE_URL=
# Indexering staat pas aan als NEXT_PUBLIC_SITE_URL is ingevuld EN dit op true
# staat. Zet dit UITSLUITEND in de Production-omgeving van Vercel.
NEXT_PUBLIC_ENABLE_INDEXING=
